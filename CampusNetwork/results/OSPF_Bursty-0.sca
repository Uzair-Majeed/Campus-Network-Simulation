version 3
run OSPF_Bursty-0-20260513-14:25:47-12729
attr configname OSPF_Bursty
attr datetime 20260513-14:25:47
attr datetimef 20260513-142547
attr experiment OSPF_Bursty
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network CampusNetwork
attr processid 12729
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../inet4.5/images
config description "OSPF Link-State Routing — Bursty Traffic"
config extends OSPF
config **.*Host*_I.app[0].trafficProfile "\"Bursty\""
config **.*Host*_I.app[0].burstSize 10
config **.*Host*_I.app[0].burstInterval 0.001
config **.*Host*_I.app[0].silenceTime 1.0
config description "OSPF Link-State Routing (INET)"
config **.isInet true
config **.hasOspf true
config **.hasRip false
config *.configurator.addStaticRoutes true
config *.configurator.addDefaultRoutes true
config *.configurator.addSubnetRoutes true
config *.configurator.config "xml(\"<config>   <interface hosts='appServer_I' address='10.0.6.2' netmask='255.255.255.0'/>   <interface hosts='dnsServer_I' address='10.0.5.2' netmask='255.255.255.0'/>   <interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/> </config>\")"
config *.*Router_I.ipv4.configurator.configureRoutingTable false
config **.ospf.ospfConfig "xml(\"<OSPFASConfig>   <Router name='**' RFC1583Compatible='true'>     <BroadcastInterface ifName='eth[*]' areaID='0.0.0.0' interfaceOutputCost='10'         helloInterval='2' routerDeadInterval='8'         retransmissionInterval='5' interfaceTransmissionDelay='1'         routerPriority='1' pollInterval='120' />   </Router> </OSPFASConfig>\")"
config *.scenarioManager.script "xmldoc(\"scenario_inet.xml\")"
config **.*Host*_I.numApps 1
config *.appServer_I.numApps 1
config *.dnsServer_I.numApps 0
config **.*Host*_I.app[0].typename TrafficGenerator
config **.*Host*_I.app[0].isInet true
config **.*Host*_I.app[0].trafficProfile "\"CBR\""
config **.*Host*_I.app[0].packetSize 512
config **.*Host*_I.app[0].sendInterval 0.1
config **.*Host*_I.app[0].destAddress "\"10.0.6.2\""
config **.*Host*_I.app[0].dnsAddress "\"0.0.0.0\""
config **.*Host*_I.app[0].startTime 1.0
config **.*Host*_I.app[0].stopTime 175.0
config *.appServer_I.app[0].typename TrafficGenerator
config *.appServer_I.app[0].isInet true
config *.appServer_I.app[0].isAppServer true
config *.appServer_I.app[0].startTime 99999.0
config *.appServer_I.app[0].stopTime 99999.0
config **.ipv4.routingTable.numRoutes.result-recording-modes vector
config **.ospf.packetSent.result-recording-modes count
config **.ospf.packetReceived.result-recording-modes count
config *.appServer_I.app[0].endToEndDelay.result-recording-modes mean,max,vector
config **.*Host*_I.app[0].packetsSent.result-recording-modes count
config *.appServer_I.app[0].packetsReceived.result-recording-modes count
config **.ipv4.ip.packetDropped.result-recording-modes count
config network CampusNetwork
config sim-time-limit 180s
config record-eventlog true
config result-dir results
config output-scalar-file results/OSPF_Bursty-0.sca
config output-vector-file results/OSPF_Bursty-0.vec

