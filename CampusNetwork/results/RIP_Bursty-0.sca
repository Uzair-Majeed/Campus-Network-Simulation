version 3
run RIP_Bursty-0-20260513-14:28:15-12971
attr configname RIP_Bursty
attr datetime 20260513-14:28:15
attr datetimef 20260513-142815
attr experiment RIP_Bursty
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network CampusNetwork
attr processid 12971
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../inet4.5/images
config description "RIP Distance-Vector Routing — Bursty Traffic"
config extends RIP
config **.*Host*_I.app[0].trafficProfile "\"Bursty\""
config **.*Host*_I.app[0].burstSize 10
config **.*Host*_I.app[0].burstInterval 0.001
config **.*Host*_I.app[0].silenceTime 1.0
config description "RIP Distance-Vector Routing (INET)"
config **.isInet true
config **.hasRip true
config **.hasOspf false
config *.configurator.config "xml(\"<config>   <interface hosts='appServer_I' address='10.0.6.2' netmask='255.255.255.0'/>   <interface hosts='dnsServer_I' address='10.0.5.2' netmask='255.255.255.0'/>   <interface hosts='**' address='10.x.x.x' netmask='255.x.x.x'/> </config>\")"
config *.configurator.addStaticRoutes true
config *.configurator.addDefaultRoutes true
config *.configurator.addSubnetRoutes true
config *.*Router_I.ipv4.configurator.configureRoutingTable false
config *.scenarioManager.script "xmldoc(\"scenario_inet.xml\")"
config **.rip.updateInterval 30s
config **.rip.routeExpiryTime 90s
config **.rip.routePurgeTime 30s
config **.rip.holdDownTime 0s
config **.rip.triggeredUpdate true
config **.rip.triggeredUpdateDelay "uniform(1s, 5s)"
config **.rip.startupTime "uniform(0s, 1s)"
config **.rip.ripConfig "xml(\"   <config>     <interface mode='NoSplitHorizon' metric='1'/>   </config>\")"
config *.coreRouter_I.rip.ripConfig "xml(\"   <config>     <interface among='coreRouter_I seRouter_I'    mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface among='coreRouter_I eeRouter_I'    mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface among='coreRouter_I bbaRouter_I'   mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface among='coreRouter_I adminRouter_I' mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface mode='NoSplitHorizon' metric='1'/>   </config>\")"
config *.seRouter_I.rip.ripConfig "xml(\"   <config>     <interface among='seRouter_I coreRouter_I' mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface mode='NoSplitHorizon' metric='1'/>   </config>\")"
config *.eeRouter_I.rip.ripConfig "xml(\"   <config>     <interface among='eeRouter_I coreRouter_I' mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface mode='NoSplitHorizon' metric='1'/>   </config>\")"
config *.bbaRouter_I.rip.ripConfig "xml(\"   <config>     <interface among='bbaRouter_I coreRouter_I' mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface mode='NoSplitHorizon' metric='1'/>   </config>\")"
config *.adminRouter_I.rip.ripConfig "xml(\"   <config>     <interface among='adminRouter_I coreRouter_I' mode='SplitHorizonPoisonedReverse' metric='1'/>     <interface mode='NoSplitHorizon' metric='1'/>   </config>\")"
config **.arp.cacheTimeout 60s
config **.*Host*_I.numApps 1
config *.appServer_I.numApps 1
config *.dnsServer_I.numApps 0
config **.*Host*_I.app[0].typename TrafficGenerator
config **.*Host*_I.app[0].isInet true
config **.*Host*_I.app[0].trafficProfile "\"CBR\""
config **.*Host*_I.app[0].packetSize 512
config **.*Host*_I.app[0].sendInterval 0.1
config **.*Host*_I.app[0].destAddress "\"10.0.6.2\""
config **.*Host*_I.app[0].dnsAddress "\"0.0.0.0\""
config **.*Host*_I.app[0].startTime 1.0
config **.*Host*_I.app[0].stopTime 175.0
config *.appServer_I.app[0].typename TrafficGenerator
config *.appServer_I.app[0].isInet true
config *.appServer_I.app[0].isAppServer true
config *.appServer_I.app[0].startTime 99999.0
config *.appServer_I.app[0].stopTime 99999.0
config **.rip.numRoutes.result-recording-modes vector
config **.rip.sentUpdate.result-recording-modes count
config **.rip.sentRequest.result-recording-modes count
config **.rip.rcvdResponse.result-recording-modes count
config *.appServer_I.app[0].endToEndDelay.result-recording-modes mean,max,vector
config **.*Host*_I.app[0].packetsSent.result-recording-modes count
config *.appServer_I.app[0].packetsReceived.result-recording-modes count
config **.ipv4.ip.packetDropped.result-recording-modes count
config network CampusNetwork
config sim-time-limit 180s
config record-eventlog true
config result-dir results
config output-scalar-file results/RIP_Bursty-0.sca
config output-vector-file results/RIP_Bursty-0.vec

